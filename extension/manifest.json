{
  "manifest_version": 3,
  "name": "OneFill AI AutoFill Assistant",
  "version": "1.0.0",
  "description": "Secure, permission-governed AI automatic form filling for Google Forms and online web applications.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneFill AutoFill Assistant",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["autofill_engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
